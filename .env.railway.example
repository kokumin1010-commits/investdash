# Public subpath used by Vite and the browser router.
VITE_APP_BASE_PATH=/investdash/

# Railway MySQL private connection string.
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE

# Long random secret for the personal passcode JWT.
JWT_SECRET=replace-with-a-long-random-secret

# Optional AI provider used when Manus Forge is unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Attach a Railway volume at this path to keep screenshot history persistent.
STORAGE_LOCAL_DIR=/data/investdash-files
PUBLIC_BASE_PATH=/investdash

# Enables the Railway in-process scheduler after database migration is complete.
# Prices: weekdays 06:30 and 21:30 UTC. News: daily 22:00-00:30 UTC in 5-minute batches.
INVESTDASH_SCHEDULER_ENABLED=false
